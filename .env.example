# DeepSeek API Key锛堝繀濉紝濉啓浣犵殑鐪熷疄 key锛?LAMP_DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 闃块噷浜?DashScope API Key锛堝繀濉紝鐢ㄤ簬鏂囨湰宓屽叆锛?LAMP_DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# 鏁版嵁搴撹矾寰勶紙閫夊～锛岄粯璁ゅ€煎嵆鍙級
LAMP_DB_PATH=data/lamp.db

# ChromaDB 鎸佷箙鍖栬矾寰勶紙閫夊～锛?LAMP_CHROMA_PERSIST_DIR=chroma_db

# 鍚戦噺妫€绱㈣繑鍥炴潯鏁帮紙閫夊～锛?LAMP_RAG_TOP_K=5


# LangFuse 可观测性（可选，注册 https://cloud.langfuse.com 获取 key）
LAMP_LANGFUSE_ENABLED=false
LAMP_LANGFUSE_PUBLIC_KEY=
LAMP_LANGFUSE_SECRET_KEY=
LAMP_LANGFUSE_HOST=https://cloud.langfuse.com
